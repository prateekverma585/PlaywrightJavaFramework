<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name = "Test for parallel runs" parallel="tests" thread-count="2">
    <test name ="RegressionTest">
        <groups>
            <run>
                <include name="Regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.FrameworkBuildDataDrivenTest"/>
            <class name="tests.UIValidationsContinued"/>
        </classes>
    </test>

    <test name="SmokeTest">
        <groups>
            <run>
                <include name="Smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.MoreUIValidationTest"/>
        </classes>
    </test>
</suite>